{
  "manifest_version": 3,
  "name": "Pinned Tab Reset",
  "version": "0.1.0",
  "description": "ショートカット一発でタブを設定済みの初期URLに戻す。閉じても初期URLで復活する固定タブを作れます。",
  "permissions": ["tabs", "contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "初期URLに戻す",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "reset-to-home": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "現在のタブを初期URLに戻す"
    }
  }
}
